Subject: [PATCH] touch: lisa: Berlin-A addresses, avdd on PM8350C LDO7, no panel straps

The redwood driver already matches lisa's serial engine (SE13 at 0xa94000), the GCC
block, the RPMh DRV 2 and the SPI/interrupt/reset pins (52-55, 81, 105); the pin
registers are at 0xf100000 + 0x1000 * n on both boards (redwood_wifi.c says so).  What
differs on the Xiaomi 11 Lite 5G NE is selected by the new boot-arg touch_lisa=1:

  - the analog supply (avdd, 3.0 V) is PM8350C LDO7 through RPMh, not GPIO 107
    (which belongs to something else on lisa and must not be driven); the I/O
    supply (iovdd, 1.62 V) is the same PM8350C LDO2
  - there are no display-maker straps on GPIO 68/96: the panel is the BOE k9d
    (display-maker 0x36), which is the Goodix variant
  - the chip is a GT9897T, a Berlin-A part: its firmware version and description
    live at 0x1000c / 0x10068 (Berlin-D: 0x10014 / 0x10070) and a read wants
    four dummy bytes rather than three.  Everything else is the same protocol.

diff --git a/xnu/files/bsd/dev/redwood_goodix.c b/xnu/files/bsd/dev/redwood_goodix.c
index f969cbd..5bb1ae6 100644
--- a/xnu/files/bsd/dev/redwood_goodix.c
+++ b/xnu/files/bsd/dev/redwood_goodix.c
@@ -44,6 +44,18 @@ extern kern_return_t thread_terminate(thread_t thread);
 
 static vm_offset_t tlmm, gcc, se, rsc, cmd_db;
 
+/*
+ * boot-arg touch_lisa=1: the Xiaomi 11 Lite 5G NE (lisa, SM7325) instead of the POCO X5 Pro
+ * (redwood).  The serial engine (SE13 at 0xa94000), the global clock controller, the RPMh
+ * "DRV 2", the command database and the SPI/interrupt/reset pins are the same on both boards.
+ * What differs:
+ *   power   the analog supply is LDO7 of the PM8350C at 3.0 V, switched through RPMh, not
+ *           GPIO 107 (that pin belongs to something else on lisa and must not be driven);
+ *           the I/O supply is the same LDO2, but the board asks for 1.62 V
+ *   panel   there are no display-maker straps on GPIO 68/96; the panel is a BOE k9d
+ */
+static bool touch_lisa;
+
 static inline uint32_t
 rd(vm_offset_t address)
 {
@@ -70,7 +82,7 @@ sleep_ms(uint32_t ms)
 
 /* ---- pins (TLMM) ------------------------------------------------------------------------------- */
 
-#define TLMM_PHYS               0x0f100000UL
+#define TLMM_PHYS               0x0f100000UL    /* the DT node is pinctrl@f000000, but pin n is at 0x1000 * n above 0xf100000 (see redwood_wifi.c) */
 #define TLMM_SIZE               0x100000UL
 #define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
 #define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
@@ -238,28 +250,42 @@ rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
 	return done;
 }
 
-/* The chip's I/O supply: 1.8 V from LDO2 of the PM8350C ("ldoc2"). Nothing else is connected to it. */
+/* Switch one PM8350C LDO on through RPMh: its voltage in millivolts, then the enable and the mode. */
 static bool
-io_supply_on(void)
+regulator_on(const char *name, uint32_t millivolts)
 {
-	uint32_t base = rpmh_address("ldoc2");
+	uint32_t base = rpmh_address(name);
 	uint32_t address[3] = { base + VRM_VOLTAGE, base + VRM_ENABLE, base + VRM_MODE };
-	uint32_t data[3] = { 1800, 1, VRM_MODE_LDO_HPM };
+	uint32_t data[3] = { millivolts, 1, VRM_MODE_LDO_HPM };
 
 	/* addresses of regulators ("VRM") have 4 in bits 19:16; anything else is not what we are looking for */
 	if (base == 0 || (base >> 16 & 0xf) != 4) {
-		printf("goodix: RPMh: no regulator \"ldoc2\" (address %#x)\n", base);
+		printf("goodix: RPMh: no regulator \"%s\" (address %#x)\n", name, base);
 		return false;
 	}
-	printf("goodix: RPMh: ldoc2 is at %#x; slot status %#x, control %#x, irq enable %#x status %#x\n", base,
+	printf("goodix: RPMh: %s is at %#x; slot status %#x, control %#x, irq enable %#x status %#x\n", name, base,
 	    rd(TCS(TCS_STATUS)), rd(TCS(TCS_CONTROL)), rd(TCS(TCS_IRQ_ENABLE)), rd(TCS(TCS_IRQ_STATUS)));
 	if (!rpmh_write(address, data, 3)) {
 		return false;
 	}
-	printf("goodix: I/O supply on (1.8 V)\n");
+	printf("goodix: %s on (%u mV)\n", name, millivolts);
 	return true;
 }
 
+/*
+ * The chip's supplies.  On redwood the I/O supply is 1.8 V from LDO2 of the PM8350C ("ldoc2") and
+ * nothing else is connected to it; the analog supply is behind GPIO 107.  On lisa the same LDO2
+ * feeds I/O at 1.62 V and LDO7 of the same PMIC ("ldoc7") feeds the analog rail at 3.0 V.
+ */
+static bool
+io_supply_on(void)
+{
+	if (touch_lisa) {
+		return regulator_on("ldoc2", 1620) && regulator_on("ldoc7", 3000);
+	}
+	return regulator_on("ldoc2", 1800);
+}
+
 /* ---- clocks (GCC) -------------------------------------------------------------------------------- */
 
 #define GCC_PHYS                0x00100000UL
@@ -593,15 +619,29 @@ static bool (*spi_transfer)(const uint8_t *tx, uint8_t *rx, uint32_t length);
 
 /* ---- the Goodix chip ------------------------------------------------------------------------------- */
 
-#define GOODIX_FW_VERSION       0x10014         /* 28 bytes */
-#define GOODIX_IC_INFO          0x10070         /* a 16-bit length, then that many bytes */
+/*
+ * The addresses and the SPI framing depend on the Berlin revision of the chip.  Berlin-D (the
+ * GT9916 of redwood) keeps its firmware version at 0x10014 and its description at 0x10070 and
+ * wants three dummy bytes after the address of a read; Berlin-A (the GT9897T of lisa) keeps them
+ * at 0x1000C and 0x10068 and wants four.  The rest of the protocol -- the 0xf1/0xf0 opcodes, the
+ * report and command layouts, the 0xaa confirmation -- is the same (Linux's goodix_berlin, which
+ * was tested on this very phone).
+ */
+#define GOODIX_FW_VERSION_D     0x10014         /* 28 bytes */
+#define GOODIX_IC_INFO_D        0x10070         /* a 16-bit length, then that many bytes */
+#define GOODIX_READ_DUMMY_D     3
+#define GOODIX_FW_VERSION_A     0x1000c
+#define GOODIX_IC_INFO_A        0x10068
+#define GOODIX_READ_DUMMY_A     4
 #define GOODIX_MAX_READ         1024
 #define GOODIX_MAX_TOUCHES      10
 #define GOODIX_STATUS_TOUCH     0x80
 #define GOODIX_STATUS_REQUEST   0x40
 #define GOODIX_REQUEST_RESET    3
 
-static uint8_t spi_tx[8 + GOODIX_MAX_READ], spi_rx[8 + GOODIX_MAX_READ];
+static uint8_t spi_tx[9 + GOODIX_MAX_READ], spi_rx[9 + GOODIX_MAX_READ];
+static uint32_t fw_version_address = GOODIX_FW_VERSION_D, ic_info_address = GOODIX_IC_INFO_D;
+static unsigned read_prefix = 1 + 4 + GOODIX_READ_DUMMY_D;    /* opcode, address, dummy bytes */
 static uint32_t touch_address, command_address;
 static const char *report_rate = "240";        /* what the status line says (touch_rate=480) */
 static uint32_t max_x = 10800, max_y = 24000;   /* the device tree's; the chip may say otherwise */
@@ -617,12 +657,12 @@ goodix_read(uint32_t address, uint8_t *data, uint32_t length)
 	spi_tx[2] = (uint8_t)(address >> 16);
 	spi_tx[3] = (uint8_t)(address >> 8);
 	spi_tx[4] = (uint8_t)address;
-	spi_tx[5] = spi_tx[6] = spi_tx[7] = 0xff;
-	memset(spi_tx + 8, 0, length);
-	if (!spi_transfer(spi_tx, spi_rx, 8 + length)) {
+	memset(spi_tx + 5, 0xff, read_prefix - 5);
+	memset(spi_tx + read_prefix, 0, length);
+	if (!spi_transfer(spi_tx, spi_rx, read_prefix + length)) {
 		return false;
 	}
-	memcpy(data, spi_rx + 8, length);
+	memcpy(data, spi_rx + read_prefix, length);
 	return true;
 }
 
@@ -687,7 +727,7 @@ goodix_probe(bool verbose)
 	uint8_t version[28];
 	uint32_t length, offset;
 
-	if (!goodix_read(GOODIX_FW_VERSION, version, sizeof(version))) {
+	if (!goodix_read(fw_version_address, version, sizeof(version))) {
 		return false;
 	}
 	if (!goodix_checksum_ok(version, sizeof(version))) {
@@ -701,11 +741,11 @@ goodix_probe(bool verbose)
 	printf("goodix: chip \"%.6s\", firmware \"%.8s\" %02x.%02x.%02x.%02x, sensor %u\n", (const char *)version,
 	    (const char *)version + 10, version[18], version[19], version[20], version[21], version[23]);
 
-	if (!goodix_read(GOODIX_IC_INFO, info, 2)) {
+	if (!goodix_read(ic_info_address, info, 2)) {
 		return false;
 	}
 	length = le16(info);
-	if (length < 40 || length >= GOODIX_MAX_READ || !goodix_read(GOODIX_IC_INFO, info, length) ||
+	if (length < 40 || length >= GOODIX_MAX_READ || !goodix_read(ic_info_address, info, length) ||
 	    !goodix_checksum_ok(info, length)) {
 		printf("goodix: bad chip description (length %u)\n", length);
 		return false;
@@ -1303,6 +1343,9 @@ static enum touch_chip touch_chip;
 static enum touch_chip
 touch_chip_detect(void)
 {
+	if (touch_lisa) {
+		return TOUCH_GOODIX;     /* no display-maker straps on lisa: it is the BOE k9d panel */
+	}
 	gpio_configure(PIN_FOCALTECH_ID, 0, PULL_NONE, 2, false);
 	gpio_configure(PIN_GOODIX_ID, 0, PULL_NONE, 2, false);
 	if (gpio_get(PIN_GOODIX_ID) && !gpio_get(PIN_FOCALTECH_ID)) {
@@ -1352,7 +1395,9 @@ power_on(void)
 	gpio_configure(PIN_INT, 0, PULL_UP, 8, false);
 	io_supply_on();
 	sleep_ms(3);
-	gpio_output(PIN_AVDD, true, PULL_NONE, 2);
+	if (!touch_lisa) {
+		gpio_output(PIN_AVDD, true, PULL_NONE, 2);      /* lisa: the analog rail is LDO7, GPIO 107 is not ours */
+	}
 	sleep_ms(15);
 }
 
@@ -1378,8 +1423,12 @@ bring_up(void)
 
 	show_state("as found");
 	touch_chip = touch_chip_detect();
-	printf("goodix: ID gpio96=%u gpio68=%u: selected %s\n", gpio_get(PIN_GOODIX_ID),
-	    gpio_get(PIN_FOCALTECH_ID), chip_name());
+	if (touch_lisa) {
+		printf("goodix: board lisa: no display-maker straps, selected %s\n", chip_name());
+	} else {
+		printf("goodix: ID gpio96=%u gpio68=%u: selected %s\n", gpio_get(PIN_GOODIX_ID),
+		    gpio_get(PIN_FOCALTECH_ID), chip_name());
+	}
 	power_on();
 
 	if (clocks_on()) {
@@ -1508,6 +1557,17 @@ redwood_goodix_init(void)
 	if (!PE_parse_boot_argn("touchscreen", &enabled, sizeof(enabled)) || !enabled) {
 		return;
 	}
+	{
+		uint32_t lisa = 0;
+
+		if (PE_parse_boot_argn("touch_lisa", &lisa, sizeof(lisa)) && lisa) {
+			touch_lisa = true;
+			/* the GT9897T is a Berlin-A part: other addresses, four dummy bytes on a read */
+			fw_version_address = GOODIX_FW_VERSION_A;
+			ic_info_address = GOODIX_IC_INFO_A;
+			read_prefix = 1 + 4 + GOODIX_READ_DUMMY_A;
+		}
+	}
 	PE_parse_boot_argn("touch_flip", &flip, sizeof(flip));
 	if (kernel_thread_start(goodix_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
