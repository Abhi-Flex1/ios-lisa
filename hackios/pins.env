# Upstream sources this repository builds. Format: NAME_REPO / NAME_SHA.
# Pinned so a rebuild is reproducible and an upstream force-push cannot
# change what we ship.  Bump deliberately, with a CI run and a NOTES entry.

HACKIOS_KERNEL_REPO="https://github.com/oosexgang/hackios-xnu-kernel"
HACKIOS_KERNEL_SHA="8e61187098f2c26c5daee8f9f72b6416aa64b9ab"   # 2026-10-22

HACKIOS_USERLAND_REPO="https://github.com/oosexgang/hackios-xnu-userland"
HACKIOS_USERLAND_SHA="a79ff0772a3454fd1ef127e181e5b3bce6c9ce18" # 2026-10-22

MU_SILICIUM_REPO="https://github.com/Project-Silicium/Mu-Silicium"
MU_SILICIUM_SHA="42fe563791e51bf5500c2e470ed294ca0c94b97c"      # 2026-10-21

# Theos' Linux toolchain (clang + cctools: ld64, nm, otool, ...) and SDK.
THEOS_REPO="https://github.com/theos/theos"
IOS_SDK="iPhoneOS16.5"
IOSTOOLCHAIN_URL="https://github.com/L1ghtmann/llvm-project/releases/latest/download/iOSToolchain-x86_64.tar.xz"

XNU_VERSION="8796.121.2"
KERNEL_PATH="xnu-src/xnu-${XNU_VERSION}/BUILD/obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837"
