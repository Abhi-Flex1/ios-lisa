Subject: [PATCH] touch: lisa: TLMM at 0xf000000, avdd on PM8350C LDO7, no panel straps

The redwood driver already matches lisa's serial engine (SE13 at 0xa94000), the GCC
block, the RPMh DRV 2 and the SPI/interrupt/reset pins (52-55, 81, 105).  Three
things differ on the Xiaomi 11 Lite 5G NE, behind the new boot-arg touch_lisa=1:

  - the TLMM block is at 0xf000000 and 16 MB long, not 0xf100000 / 1 MB
  - the analog supply (avdd, 3.0 V) is PM8350C LDO7 through RPMh, not GPIO 107
    (which belongs to something else on lisa and must not be driven); the I/O
    supply (iovdd, 1.62 V) is the same PM8350C LDO2
  - there are no display-maker straps on GPIO 68/96: the panel is the BOE k9d
    (display-maker 0x36), which is the Goodix variant

diff --git a/xnu/files/bsd/dev/redwood_goodix.c b/xnu/files/bsd/dev/redwood_goodix.c
index f969cbd..4104f17 100644
--- a/xnu/files/bsd/dev/redwood_goodix.c
+++ b/xnu/files/bsd/dev/redwood_goodix.c
@@ -44,6 +44,19 @@ extern kern_return_t thread_terminate(thread_t thread);
 
 static vm_offset_t tlmm, gcc, se, rsc, cmd_db;
 
+/*
+ * boot-arg touch_lisa=1: the Xiaomi 11 Lite 5G NE (lisa, SM7325) instead of the POCO X5 Pro
+ * (redwood).  The serial engine (SE13 at 0xa94000), the global clock controller, the RPMh
+ * "DRV 2", the command database and the SPI/interrupt/reset pins are the same on both boards.
+ * What differs:
+ *   pins    the TLMM block sits at 0xf000000 (16 MB) instead of 0xf100000 (1 MB)
+ *   power   the analog supply is LDO7 of the PM8350C at 3.0 V, switched through RPMh, not
+ *           GPIO 107 (that pin belongs to something else on lisa and must not be driven);
+ *           the I/O supply is the same LDO2, but the board asks for 1.62 V
+ *   panel   there are no display-maker straps on GPIO 68/96; the panel is a BOE k9d
+ */
+static bool touch_lisa;
+
 static inline uint32_t
 rd(vm_offset_t address)
 {
@@ -70,8 +83,10 @@ sleep_ms(uint32_t ms)
 
 /* ---- pins (TLMM) ------------------------------------------------------------------------------- */
 
-#define TLMM_PHYS               0x0f100000UL
-#define TLMM_SIZE               0x100000UL
+#define TLMM_PHYS_REDWOOD       0x0f100000UL
+#define TLMM_SIZE_REDWOOD       0x100000UL
+#define TLMM_PHYS_LISA          0x0f000000UL   /* boot-arg touch_lisa=1 */
+#define TLMM_SIZE_LISA          0x1000000UL
 #define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
 #define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
 #define PULL_NONE               0
@@ -238,28 +253,42 @@ rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
 	return done;
 }
 
-/* The chip's I/O supply: 1.8 V from LDO2 of the PM8350C ("ldoc2"). Nothing else is connected to it. */
+/* Switch one PM8350C LDO on through RPMh: its voltage in millivolts, then the enable and the mode. */
 static bool
-io_supply_on(void)
+regulator_on(const char *name, uint32_t millivolts)
 {
-	uint32_t base = rpmh_address("ldoc2");
+	uint32_t base = rpmh_address(name);
 	uint32_t address[3] = { base + VRM_VOLTAGE, base + VRM_ENABLE, base + VRM_MODE };
-	uint32_t data[3] = { 1800, 1, VRM_MODE_LDO_HPM };
+	uint32_t data[3] = { millivolts, 1, VRM_MODE_LDO_HPM };
 
 	/* addresses of regulators ("VRM") have 4 in bits 19:16; anything else is not what we are looking for */
 	if (base == 0 || (base >> 16 & 0xf) != 4) {
-		printf("goodix: RPMh: no regulator \"ldoc2\" (address %#x)\n", base);
+		printf("goodix: RPMh: no regulator \"%s\" (address %#x)\n", name, base);
 		return false;
 	}
-	printf("goodix: RPMh: ldoc2 is at %#x; slot status %#x, control %#x, irq enable %#x status %#x\n", base,
+	printf("goodix: RPMh: %s is at %#x; slot status %#x, control %#x, irq enable %#x status %#x\n", name, base,
 	    rd(TCS(TCS_STATUS)), rd(TCS(TCS_CONTROL)), rd(TCS(TCS_IRQ_ENABLE)), rd(TCS(TCS_IRQ_STATUS)));
 	if (!rpmh_write(address, data, 3)) {
 		return false;
 	}
-	printf("goodix: I/O supply on (1.8 V)\n");
+	printf("goodix: %s on (%u mV)\n", name, millivolts);
 	return true;
 }
 
+/*
+ * The chip's supplies.  On redwood the I/O supply is 1.8 V from LDO2 of the PM8350C ("ldoc2") and
+ * nothing else is connected to it; the analog supply is behind GPIO 107.  On lisa the same LDO2
+ * feeds I/O at 1.62 V and LDO7 of the same PMIC ("ldoc7") feeds the analog rail at 3.0 V.
+ */
+static bool
+io_supply_on(void)
+{
+	if (touch_lisa) {
+		return regulator_on("ldoc2", 1620) && regulator_on("ldoc7", 3000);
+	}
+	return regulator_on("ldoc2", 1800);
+}
+
 /* ---- clocks (GCC) -------------------------------------------------------------------------------- */
 
 #define GCC_PHYS                0x00100000UL
@@ -1303,6 +1332,9 @@ static enum touch_chip touch_chip;
 static enum touch_chip
 touch_chip_detect(void)
 {
+	if (touch_lisa) {
+		return TOUCH_GOODIX;     /* no display-maker straps on lisa: it is the BOE k9d panel */
+	}
 	gpio_configure(PIN_FOCALTECH_ID, 0, PULL_NONE, 2, false);
 	gpio_configure(PIN_GOODIX_ID, 0, PULL_NONE, 2, false);
 	if (gpio_get(PIN_GOODIX_ID) && !gpio_get(PIN_FOCALTECH_ID)) {
@@ -1352,7 +1384,9 @@ power_on(void)
 	gpio_configure(PIN_INT, 0, PULL_UP, 8, false);
 	io_supply_on();
 	sleep_ms(3);
-	gpio_output(PIN_AVDD, true, PULL_NONE, 2);
+	if (!touch_lisa) {
+		gpio_output(PIN_AVDD, true, PULL_NONE, 2);      /* lisa: the analog rail is LDO7, GPIO 107 is not ours */
+	}
 	sleep_ms(15);
 }
 
@@ -1378,8 +1412,12 @@ bring_up(void)
 
 	show_state("as found");
 	touch_chip = touch_chip_detect();
-	printf("goodix: ID gpio96=%u gpio68=%u: selected %s\n", gpio_get(PIN_GOODIX_ID),
-	    gpio_get(PIN_FOCALTECH_ID), chip_name());
+	if (touch_lisa) {
+		printf("goodix: board lisa: no display-maker straps, selected %s\n", chip_name());
+	} else {
+		printf("goodix: ID gpio96=%u gpio68=%u: selected %s\n", gpio_get(PIN_GOODIX_ID),
+		    gpio_get(PIN_FOCALTECH_ID), chip_name());
+	}
 	power_on();
 
 	if (clocks_on()) {
@@ -1445,7 +1483,8 @@ goodix_thread(__unused void *parameter, __unused wait_result_t result)
 	}
 	idle_looks = 80000 / poll_us;   /* a report read every 80 ms even with the line high, in case it is missed */
 
-	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	tlmm = ml_io_map(touch_lisa ? TLMM_PHYS_LISA : TLMM_PHYS_REDWOOD,
+	    touch_lisa ? TLMM_SIZE_LISA : TLMM_SIZE_REDWOOD);
 	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
 	se = ml_io_map(SE_PHYS, SE_SIZE);
 	rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
@@ -1508,6 +1547,13 @@ redwood_goodix_init(void)
 	if (!PE_parse_boot_argn("touchscreen", &enabled, sizeof(enabled)) || !enabled) {
 		return;
 	}
+	{
+		uint32_t lisa = 0;
+
+		if (PE_parse_boot_argn("touch_lisa", &lisa, sizeof(lisa)) && lisa) {
+			touch_lisa = true;
+		}
+	}
 	PE_parse_boot_argn("touch_flip", &flip, sizeof(flip));
 	if (kernel_thread_start(goodix_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
