diff --git a/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/BootManager.c b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/BootManager.c
index f5bff32..c038566 100644
--- a/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/BootManager.c
+++ b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/BootManager.c
@@ -125,6 +125,18 @@ PlatformBootManagerAfterConsole ()
 
   // Execute Secondary After Console
   DeviceBootManagerAfterConsole ();
+
+  //
+  // A boot-image payload carrying "loader.efi" means this boot was started by
+  // us. Hand over right here, before boot options are enumerated: waiting for
+  // PlatformBootManagerUnableToBoot only works on a device with nothing
+  // installed, and this phone still has a Windows entry that BDS would pick
+  // (and fail on) first.
+  //
+  if (XnuLoaderPayloadPresent ()) {
+    // Does not return when the payload loader runs.
+    XnuLoaderMain ();
+  }
 }
 
 VOID
