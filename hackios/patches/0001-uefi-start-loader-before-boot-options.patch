+
+STATIC
+VOID
+StartPayloadLoader ()
+{
+  XNU_PAYLOAD_ENTRY *Entry = FindPayloadEntry ("loader.efi");
+  EFI_HANDLE         Handle;
+
+  if (Entry == NULL) {
+    return;
+  }
+
+  Print (L"XNU: loader.efi, %d bytes, payload %lx\r\n", (UINTN)Entry->Size, (UINT64)XNU_PAYLOAD_BASE);
+
+  if (EFI_ERROR (gBS->LoadImage (FALSE, gImageHandle, NULL, Entry + 1, Entry->Size, &Handle))) {
+    Print (L"XNU: LoadImage failed\r\n");
+    return;
+  }
+
+  // Normally does not return: the loader takes over the machine.
+  Print (L"XNU: StartImage\r\n");
+  if (EFI_ERROR (gBS->StartImage (Handle, NULL, NULL))) {
+    Print (L"XNU: StartImage failed\r\n");
+    return;
+  }
+
+  Print (L"XNU: loader returned\r\n");
 }
 
